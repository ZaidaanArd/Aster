<UserControl x:Class="DynamicIsland.Controls.IslandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="252"
             Width="260"
             Height="40"
             Focusable="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             AllowDrop="True"
             PreviewDragEnter="OnShelfDragEnter"
             PreviewDragOver="OnShelfDragOver"
             PreviewDragLeave="OnShelfDragLeave"
             PreviewDrop="OnShelfDrop">

    <Grid>
        <Border x:Name="ShadowBorder"
                Background="{StaticResource IslandGlassShadow}"
                CornerRadius="0,0,22,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border x:Name="IslandBorder"
                Background="{StaticResource IslandGlassBackground}"
                BorderBrush="{StaticResource IslandStroke}"
                BorderThickness="0,0,1,1"
                CornerRadius="0,0,22,22"
                ClipToBounds="True">
            <Grid>
                <Rectangle x:Name="GlassNoise"
                           IsHitTestVisible="False"
                           Opacity="0.035">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Assets/glass-noise.png"
                                    TileMode="Tile"
                                    Viewport="0,0,64,64"
                                    ViewportUnits="Absolute"
                                    Stretch="None" />
                    </Rectangle.Fill>
                </Rectangle>

                <Border x:Name="GlassTopGlow"
                        Height="64"
                        VerticalAlignment="Top"
                        Background="{StaticResource IslandTopGlow}"
                        IsHitTestVisible="False" />

                <Border x:Name="GlassRim"
                        Margin="1"
                        CornerRadius="21"
                        BorderBrush="{StaticResource IslandRimBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False" />

                <!-- Collapsed: clock / timer / mascot -->
                <Grid x:Name="CollapsedLayer" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Grid Height="40">
                        <TextBlock x:Name="ClockText"
                                   Text="--:--"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F2FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <Canvas x:Name="EyesCanvas"
                                Width="58"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0">
                            <Grid x:Name="EyeLeft"
                                  Canvas.Left="5"
                                  Canvas.Top="2"
                                  Width="18"
                                  Height="18"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="EyeLeftScale" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#F2FFFFFF" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="#08080A"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="2,0,0,0" />
                            </Grid>
                            <Grid x:Name="EyeRight"
                                  Canvas.Left="35"
                                  Canvas.Top="2"
                                  Width="18"
                                  Height="18"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="EyeRightScale" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#F2FFFFFF" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="#08080A"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="2,0,0,0" />
                            </Grid>
                        </Canvas>

                        <Ellipse x:Name="MediaDot"
                                 Width="6"
                                 Height="6"
                                 Fill="{StaticResource AccentGreen}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="15,0,0,0"
                                 Opacity="0" />
                    </Grid>
                </Grid>

                <!-- Expanded panel -->
                <Grid x:Name="ExpandedLayer"
                      Width="464"
                      Height="216"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,18,0,0"
                      Opacity="0"
                      IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="DateText"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="WaterButton"
                                    Style="{StaticResource GlyphButton}"
                                    Width="40"
                                    Height="18"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    Foreground="{StaticResource AccentWater}"
                                    Visibility="Collapsed"
                                    Click="OnWaterClick"
                                    ToolTip="Log a glass of water">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="8"
                                          Height="11"
                                          Stretch="Fill"
                                          VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M4,0 C4,0 0.8,4.4 0.8,7 A3.2,3.2 0 0 0 7.2,7 C7.2,4.4 4,0 4,0 Z" />
                                    <TextBlock x:Name="WaterCountText"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="9.5"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="0/8" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="WifiGlyph"
                                       Style="{StaticResource Glyph}"
                                       Text="&#xE701;"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,9,0" />
                            <Grid x:Name="BatteryWidget" Width="24" Height="12" VerticalAlignment="Center">
                                <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="3" />
                                <Border x:Name="BatteryFill"
                                        Background="#F5F5F7"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Margin="2"
                                        Width="0" />
                                <Border Width="2"
                                        Height="4"
                                        Background="#66FFFFFF"
                                        CornerRadius="0,1,1,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-3,0" />
                            </Grid>
                            <TextBlock x:Name="BatteryText"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Music (with the optional lyrics pane) and Focus -->
                    <Grid x:Name="SlideHost" Grid.Row="1" ClipToBounds="True">
                        <Grid x:Name="MusicView"
                              Width="464"
                              Height="170"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Opacity="1"
                              ClipToBounds="True">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MusicTranslate" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="152" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="MusicContent" Grid.Row="0" Orientation="Horizontal">
                                <Grid x:Name="MusicMedia" Width="464" Height="152">
                                    <Grid x:Name="MusicPanel" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ArtBorder"
                                            Width="84"
                                            Height="84"
                                            CornerRadius="18"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                        <Grid>
                                            <Border x:Name="ArtFallback" CornerRadius="18">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#2B2A46" Offset="0" />
                                                        <GradientStop Color="#15151E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock x:Name="ArtGlyph"
                                                       Text="&#xE8D6;"
                                                       FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="30"
                                                       Foreground="#66FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="MusicInfoTranslate" />
                                        </Grid.RenderTransform>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="TitleText"
                                                   Grid.Row="0"
                                                   Style="{StaticResource TitleText}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="Nothing playing" />
                                        <TextBlock x:Name="ArtistText"
                                                   Grid.Row="1"
                                                   Style="{StaticResource SubtitleText}"
                                                   FontSize="11.5"
                                                   Margin="0,2,0,0"
                                                   Text="Start something on Spotify, YouTube, or Apple Music" />

                                        <Grid x:Name="ProgressHit"
                                              Grid.Row="2"
                                              Height="14"
                                              Margin="0,9,0,0"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="OnProgressMouseDown"
                                              SizeChanged="OnProgressSizeChanged">
                                            <Border Height="4"
                                                    CornerRadius="2"
                                                    Background="{StaticResource TrackBrush}"
                                                    VerticalAlignment="Center" />
                                            <Border x:Name="ProgressFill"
                                                    Height="4"
                                                    CornerRadius="2"
                                                    Background="#F2FFFFFF"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Width="0" />
                                        </Grid>

                                        <Grid Grid.Row="3" Margin="0,5,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button x:Name="PrevButton"
                                                        Style="{StaticResource GlyphButton}"
                                                        Click="OnPreviousClick"
                                                        ToolTip="Previous">
                                                    <TextBlock Text="&#xE892;"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="13" />
                                                </Button>
                                                <Button x:Name="PlayButton"
                                                        Style="{StaticResource PlayButton}"
                                                        Margin="8,0"
                                                        Click="OnPlayPauseClick"
                                                        ToolTip="Play / pause">
                                                    <TextBlock x:Name="PlayGlyph"
                                                               Text="&#xE768;"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="13"
                                                               Margin="1,0,0,0" />
                                                </Button>
                                                <Button x:Name="NextButton"
                                                        Style="{StaticResource GlyphButton}"
                                                        Click="OnNextClick"
                                                        ToolTip="Next">
                                                    <TextBlock Text="&#xE893;"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="13" />
                                                </Button>
                                            </StackPanel>

                                            <Button x:Name="LyricsButton"
                                                    Style="{StaticResource GlyphButton}"
                                                    Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Right"
                                                    Click="OnLyricsButtonClick"
                                                    ToolTip="Show lyrics">
                                                <TextBlock Text="&#xE8BD;"
                                                           FontFamily="{StaticResource GlyphFont}"
                                                           FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                </Grid>

                                <!-- Lyrics pane: the LyricsView is added here in code-behind -->
                                <Grid x:Name="LyricsPane"
                                      Width="0"
                                      Height="152"
                                      Visibility="Collapsed"
                                      ClipToBounds="True"
                                      Background="{StaticResource IslandGlassLyrics}">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="LyricsTranslate" />
                                    </Grid.RenderTransform>
                                </Grid>
                            </StackPanel>

                            <Grid x:Name="MusicFooter" Grid.Row="1" Width="464" HorizontalAlignment="Left">
                                <TextBlock x:Name="FooterText"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextTertiary}"
                                           VerticalAlignment="Bottom" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Ellipse x:Name="PlayingDot"
                                             Width="5"
                                             Height="5"
                                             Fill="{StaticResource AccentGreen}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"
                                             Opacity="0" />
                                    <TextBlock x:Name="FooterSource"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="CameraHost" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CameraTranslate" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Grid x:Name="ShelfHost" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ShelfTranslate" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Grid x:Name="FocusHost" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FocusTranslate" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Grid x:Name="DropOverlay"
                              Visibility="Collapsed"
                              IsHitTestVisible="False"
                              Panel.ZIndex="20">
                            <Border Background="#E6070708" CornerRadius="12" />
                            <Rectangle Margin="2"
                                       Stroke="{StaticResource LyricsAccent}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4 3"
                                       RadiusX="12"
                                       RadiusY="12" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="{StaticResource GlyphFont}"
                                           FontSize="24"
                                           Foreground="{StaticResource LyricsAccent}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Drop to add to shelf"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Files stay until you close the app"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextTertiary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Tab bar -->
                    <Grid Grid.Row="2">
                        <Grid x:Name="TabStrip" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="TabHighlight"
                                    Width="30"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#1FFFFFFF"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabHighlightTransform" />
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="2,0">
                                    <RadioButton x:Name="MusicTab"
                                                 Style="{StaticResource TabButton}"
                                                 GroupName="IslandTabs"
                                                 IsChecked="True"
                                                 Checked="OnMusicTabChecked"
                                                 ToolTip="Music">
                                        <TextBlock Text="&#xE8D6;"
                                                   FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="13" />
                                    </RadioButton>
                                </Grid>
                                <Grid Margin="2,0">
                                    <RadioButton x:Name="CameraTab"
                                                 Style="{StaticResource TabButton}"
                                                 GroupName="IslandTabs"
                                                 Checked="OnCameraTabChecked"
                                                 ToolTip="Camera">
                                        <TextBlock Text="&#xE722;"
                                                   FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="13" />
                                    </RadioButton>
                                </Grid>
                                <Grid Margin="2,0">
                                    <RadioButton x:Name="ShelfTab"
                                                 Style="{StaticResource TabButton}"
                                                 GroupName="IslandTabs"
                                                 Checked="OnShelfTabChecked"
                                                 ToolTip="File shelf">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="13" />
                                    </RadioButton>
                                    <Ellipse x:Name="ShelfTabDot"
                                             Width="5"
                                             Height="5"
                                             Fill="{StaticResource LyricsAccent}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,2,3,0"
                                             Opacity="0"
                                             IsHitTestVisible="False" />
                                </Grid>
                                <Grid Margin="2,0">
                                    <RadioButton x:Name="FocusTab"
                                                 Style="{StaticResource TabButton}"
                                                 GroupName="IslandTabs"
                                                 Checked="OnFocusTabChecked"
                                                 ToolTip="Focus timer">
                                        <TextBlock Text="&#xE916;"
                                                   FontFamily="{StaticResource GlyphFont}"
                                                   FontSize="13" />
                                    </RadioButton>
                                    <Ellipse x:Name="FocusTabDot"
                                             Width="5"
                                             Height="5"
                                             Fill="{StaticResource FocusAccent}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,2,3,0"
                                             Opacity="0"
                                             IsHitTestVisible="False" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="SettingsButton"
                                Style="{StaticResource GlyphButton}"
                                Width="28"
                                Height="24"
                                HorizontalAlignment="Right"
                                Click="OnSettingsClick"
                                ToolTip="Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="{StaticResource GlyphFont}"
                                       FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Volume / brightness / charging / focus toast -->
                <Border x:Name="ToastBorder"
                        Width="212"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,5,0,0"
                        Padding="12,6"
                        Background="{StaticResource IslandGlassToast}"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        MouseLeftButtonDown="OnToastMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToastGlyph"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="14"
                                   Foreground="#F2FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Path x:Name="ToastDrop"
                              Grid.Column="0"
                              Width="9"
                              Height="12"
                              Margin="0,0,8,0"
                              Stretch="Fill"
                              VerticalAlignment="Center"
                              Fill="{StaticResource AccentWater}"
                              Visibility="Collapsed"
                              Data="M4,0 C4,0 0.8,4.4 0.8,7 A3.2,3.2 0 0 0 7.2,7 C7.2,4.4 4,0 4,0 Z" />
                        <TextBlock x:Name="ToastLabel"
                                   Grid.Column="1"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border x:Name="ToastTrack"
                                Grid.Column="2"
                                Width="50"
                                Height="4"
                                CornerRadius="2"
                                Background="{StaticResource TrackBrush}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <Border x:Name="ToastFill"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#F2FFFFFF"
                                    HorizontalAlignment="Left"
                                    Width="0" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
