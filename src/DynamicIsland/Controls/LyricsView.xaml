<UserControl x:Class="DynamicIsland.Controls.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="204"
             d:DesignHeight="152"
             Focusable="False"
             Background="Transparent">

    <Grid Margin="3,5,2,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="LYRICS"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" />
                <Ellipse x:Name="StatusDot"
                         Width="4.5"
                         Height="4.5"
                         Fill="{StaticResource LyricsAccent}"
                         Margin="8,0,5,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="LyricsStatus"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"
                           Text="LRCLIB" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Style="{StaticResource GlyphButton}"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Right"
                    Click="OnRefreshClick"
                    ToolTip="Refresh lyrics">
                <TextBlock x:Name="RefreshGlyph"
                           Text="&#xE72C;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="11"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="RefreshRotate" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>

            <Border Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#04FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <ScrollViewer x:Name="LyricsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,2,4,2"
                      Focusable="False"
                      PreviewMouseWheel="OnLyricsWheel">
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.04" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.96" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <StackPanel x:Name="LyricsStack" Margin="0,6,0,6" />
        </ScrollViewer>

        <StackPanel x:Name="LyricsMessagePanel"
                    Grid.Row="1"
                    MaxWidth="166"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="LyricsMessageGlyph"
                       FontFamily="{StaticResource GlyphFont}"
                       FontSize="22"
                       Foreground="#33FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"
                       Text="&#xE8D6;" />
            <TextBlock x:Name="LyricsMessage"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="10.5"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       LineHeight="15" />
        </StackPanel>
    </Grid>
</UserControl>
