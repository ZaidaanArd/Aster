<UserControl x:Class="DynamicIsland.Controls.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="204"
             d:DesignHeight="170"
             Focusable="False"
             Background="Transparent">

    <Grid Margin="0,6,0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="LYRICS"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="LyricsStatus"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9.5"
                           Foreground="{StaticResource TextTertiary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Style="{StaticResource GlyphButton}"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    Click="OnRefreshClick"
                    ToolTip="Refresh lyrics">
                <TextBlock Text="&#xE72C;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="11" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="LyricsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0"
                      Focusable="False">
            <StackPanel x:Name="LyricsStack" />
        </ScrollViewer>

        <TextBlock x:Name="LyricsMessage"
                   Grid.Row="1"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="11.5"
                   Foreground="{StaticResource TextTertiary}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="170"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
