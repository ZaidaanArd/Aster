<UserControl x:Class="DynamicIsland.Controls.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="604"
             d:DesignHeight="258"
             Focusable="False"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Compact player -->
        <Grid Grid.Column="0" Margin="0,6,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ArtBorder"
                    Width="84"
                    Height="84"
                    CornerRadius="18"
                    ClipToBounds="True"
                    HorizontalAlignment="Left">
                <Border.Background>
                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                </Border.Background>
                <Grid>
                    <Border x:Name="ArtFallback" CornerRadius="18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B2A46" Offset="0" />
                                <GradientStop Color="#15151E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="ArtGlyph"
                               Text="&#xE8BD;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="28"
                               Foreground="#66FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="TitleText"
                       Grid.Row="1"
                       Style="{StaticResource TitleText}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0"
                       Text="Nothing playing" />
            <TextBlock x:Name="ArtistText"
                       Grid.Row="2"
                       Style="{StaticResource SubtitleText}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       Text="Play something to see lyrics" />

            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                <Grid x:Name="ProgressHit"
                      Height="10"
                      Margin="0,0,0,5"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseLeftButtonDown="OnProgressMouseDown"
                      SizeChanged="OnProgressSizeChanged">
                    <Border Height="4"
                            CornerRadius="2"
                            Background="{StaticResource TrackBrush}"
                            VerticalAlignment="Center" />
                    <Border x:Name="ProgressFill"
                            Height="4"
                            CornerRadius="2"
                            Background="#F2FFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="0" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton"
                            Style="{StaticResource PlayButton}"
                            Width="36"
                            Height="36"
                            Click="OnPlayPauseClick"
                            ToolTip="Play / pause">
                        <TextBlock x:Name="PlayGlyph"
                                   Text="&#xE768;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="13"
                                   Margin="1,0,0,0" />
                    </Button>
                    <TextBlock x:Name="TimeText"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Lyrics -->
        <Grid Grid.Column="2" Margin="0,4,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LYRICS"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="LyricsStatus"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Style="{StaticResource GlyphButton}"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        Click="OnRefreshClick"
                        ToolTip="Refresh lyrics">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="11" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="LyricsScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0"
                          Focusable="False">
                <StackPanel x:Name="LyricsStack" />
            </ScrollViewer>

            <TextBlock x:Name="LyricsMessage"
                       Grid.Row="1"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="11.5"
                       Foreground="{StaticResource TextTertiary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>

