<UserControl x:Class="DynamicIsland.Controls.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="464"
             d:DesignHeight="170"
             Width="464"
             Height="170"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ShelfCard" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1CFFFFFF" />
                    <Setter Property="BorderBrush" Value="#2AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,4,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SHELF"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="ShelfCount"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           Foreground="{StaticResource TextTertiary}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="0/8" />
            </StackPanel>

            <Button x:Name="ClearButton"
                    Style="{StaticResource DarkButton}"
                    Content="Clear"
                    FontSize="9.5"
                    Padding="8,3"
                    Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnClearClick" />

            <Border Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#04FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <UniformGrid x:Name="ShelfGrid"
                         Columns="4"
                         Rows="2"
                         Margin="8,4,8,4"
                         Visibility="Collapsed" />

            <Grid x:Name="EmptyState" Margin="8,4,8,8">
                <Rectangle Stroke="#2EFFFFFF"
                           StrokeThickness="1.2"
                           StrokeDashArray="4 3"
                           RadiusX="12"
                           RadiusY="12" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="24"
                               Foreground="#33FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Drag files here"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <TextBlock Text="They stay until you close the app"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9"
                               Foreground="{StaticResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
