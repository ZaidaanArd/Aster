<UserControl x:Class="DynamicIsland.Controls.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="464"
             d:DesignHeight="148"
             Focusable="False"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,1,0,0">
            <Button x:Name="FocusChip"
                    Style="{StaticResource ChipButton}"
                    Content="Focus 25"
                    Margin="0,0,4,0"
                    Click="OnFocusChipClick" />
            <Button x:Name="ShortChip"
                    Style="{StaticResource ChipButton}"
                    Content="Short 5"
                    Margin="0,0,4,0"
                    Click="OnShortChipClick" />
            <Button x:Name="LongChip"
                    Style="{StaticResource ChipButton}"
                    Content="Long 15"
                    Click="OnLongChipClick" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="CountdownText"
                       Text="25:00"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Typography.NumeralStyle="Lining" />

            <Grid x:Name="ProgressHit"
                  Height="10"
                  Margin="56,1,56,0"
                  Background="Transparent"
                  SizeChanged="OnProgressSizeChanged">
                <Border Height="4"
                        CornerRadius="2"
                        Background="{StaticResource TrackBrush}"
                        VerticalAlignment="Center" />
                <Border x:Name="ProgressFill"
                        Height="4"
                        CornerRadius="2"
                        Background="{StaticResource FocusAccent}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,0">
            <Button x:Name="StartButton"
                    Style="{StaticResource PlayButton}"
                    Width="40"
                    Height="40"
                    Click="OnStartClick"
                    ToolTip="Start / pause">
                <TextBlock x:Name="StartGlyph"
                           Text="&#xE768;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="14"
                           Margin="1,0,0,0" />
            </Button>
            <Button x:Name="ResetButton"
                    Style="{StaticResource GlyphButton}"
                    Width="36"
                    Height="36"
                    Margin="10,0,0,0"
                    Click="OnResetClick"
                    ToolTip="Reset">
                <TextBlock Text="&#xE72C;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="13" />
            </Button>
            <Button x:Name="BreakButton"
                    Style="{StaticResource DarkButton}"
                    Content="Start break"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    FontSize="10.5"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnBreakClick" />
        </StackPanel>

        <TextBlock x:Name="SessionText"
                   Grid.Row="3"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="9.5"
                   Foreground="{StaticResource TextTertiary}"
                   HorizontalAlignment="Center"
                   Margin="0,1,0,0"
                   Text="0 sessions today" />
    </Grid>
</UserControl>
