<UserControl x:Class="DynamicIsland.Controls.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="464"
             d:DesignHeight="170"
             Width="464"
             Height="170"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Focusable="False"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="302" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="PreviewBorder"
                Width="302"
                Height="170"
                CornerRadius="16"
                Background="#FF0B0B0D"
                ClipToBounds="True">
            <Grid>
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,302,170" RadiusX="16" RadiusY="16" />
                </Grid.Clip>
                <Image x:Name="PreviewImage"
                       Stretch="UniformToFill"
                       Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="MirrorTransform" ScaleX="1" />
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="PreviewPlaceholder"
                           Text="&#xE722;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="34"
                           Foreground="#2EFFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Border x:Name="LiveChip"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12,10,0,0"
                        Padding="6,3"
                        CornerRadius="8"
                        Background="#CC000000"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{StaticResource AccentGreen}"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="LIVE"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E8FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="FlashOverlay"
                        Background="#FFFFFF"
                        Opacity="0"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="10,4,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CAMERA"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" />
                <Ellipse x:Name="CameraDot"
                         Width="4.5"
                         Height="4.5"
                         Fill="{StaticResource TextTertiary}"
                         Margin="8,0,4,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="CameraStateText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"
                           Text="OFF" />
            </StackPanel>

            <TextBlock x:Name="DeviceText"
                       Grid.Row="1"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="9.5"
                       Foreground="{StaticResource TextTertiary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,0"
                       Text="No camera" />

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <CheckBox x:Name="MirrorToggle"
                          Style="{StaticResource ToggleSwitch}"
                          Content="Mirror"
                          FontSize="10.5"
                          IsChecked="True"
                          IsEnabled="False"
                          Margin="0,0,0,6"
                          Checked="OnMirrorChanged"
                          Unchecked="OnMirrorChanged" />

                <Button x:Name="ShutterButton"
                        Style="{StaticResource GlyphButton}"
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="OnShutterClick"
                        ToolTip="Take a photo">
                    <Grid Width="42" Height="42">
                        <Ellipse Fill="#F5F5F7" />
                        <Ellipse Width="34" Height="34" Fill="#0B0B0D" />
                        <Ellipse Width="24" Height="24" Fill="#F5F5F7" />
                    </Grid>
                </Button>

                <Button x:Name="SwitchButton"
                        Style="{StaticResource DarkButton}"
                        Content="Switch camera"
                        FontSize="10"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        Click="OnSwitchClick" />

                <Button x:Name="RetryButton"
                        Style="{StaticResource DarkButton}"
                        Content="Retry"
                        FontSize="10"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Visibility="Collapsed"
                        Click="OnRetryClick" />

                <Button x:Name="OpenSettingsButton"
                        Style="{StaticResource DarkButton}"
                        Content="Camera settings"
                        FontSize="10"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Visibility="Collapsed"
                        Click="OnOpenSettingsClick" />
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock x:Name="StatusText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="9"
                           Foreground="{StaticResource TextTertiary}"
                           TextWrapping="Wrap"
                           LineHeight="12"
                           Text="Camera off" />
                <TextBlock x:Name="HintText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="8"
                           Foreground="{StaticResource TextTertiary}"
                           Opacity="0.7"
                           Margin="0,2,0,0"
                           Text="Photos → Pictures" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
