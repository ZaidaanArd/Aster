<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="740"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnSettingsLoaded"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="32">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF"
                                                        CornerRadius="4"
                                                        Margin="1,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            Margin="10"
            CornerRadius="22"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                <GradientStop Color="#F515151B" Offset="0" />
                <GradientStop Color="#F40C0C11" Offset="0.58" />
                <GradientStop Color="#F507070A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="9"
                              Direction="270"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="8"
                            Background="#12FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource LyricsAccent}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Dynamic Island"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Settings"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="7,1,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Style="{StaticResource GlyphButton}"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Click="OnCloseClick"
                        ToolTip="Close">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="12" />
                </Button>
            </Grid>

            <!-- Sidebar + pages -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="10,0,0,10"
                        CornerRadius="16"
                        Background="#06FFFFFF"
                        BorderBrush="#0FFFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="8,10,8,0">
                            <RadioButton x:Name="NavGeneral"
                                         Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="General"
                                         Checked="OnNavChecked"
                                         Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="13"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="General"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="Appearance"
                                         Checked="OnNavChecked"
                                         Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="13"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Appearance"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="Lyrics"
                                         Checked="OnNavChecked"
                                         Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="13"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Lyrics"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="Focus"
                                         Checked="OnNavChecked"
                                         Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="13"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Focus"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="Water"
                                         Checked="OnNavChecked"
                                         Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18">
                                        <Path Width="9"
                                              Height="12"
                                              Stretch="Fill"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Data="M4,0 C4,0 0.8,4.4 0.8,7 A3.2,3.2 0 0 0 7.2,7 C7.2,4.4 4,0 4,0 Z" />
                                    </Grid>
                                    <TextBlock Text="Water"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}"
                                         GroupName="SettingsNav"
                                         Tag="About"
                                         Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="13"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="About"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="16,0,16,16">
                            <TextBlock x:Name="VersionText"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,10,24,0">
                        <TextBlock x:Name="PageTitle"
                                   Text="General"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Startup and fullscreen behavior."
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="24,14,24,0">
                        <!-- General -->
                        <ScrollViewer x:Name="GeneralPage"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="STARTUP" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkStartup"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Launch Dynamic Island automatically when you sign in." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="FULLSCREEN" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkFullscreen"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Hide in fullscreen" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Step out of the way while games or videos are fullscreen." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Appearance -->
                        <ScrollViewer x:Name="AppearancePage"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="ISLAND" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkMascot"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Margin="0,0,0,14"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Show mascot when idle" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="The clock fades into a pair of eyes when the island is idle." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkMinimal"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Minimal notch" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Shrink the compact island to a thin 160 × 12 notch." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="OVERLAYS" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkVolume"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Margin="0,0,0,14"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Volume overlay" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Show a small toast when system volume changes." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkBrightness"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Brightness overlay" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Show a small toast when screen brightness changes." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="GLASS &amp; MOTION" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkGlass"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Margin="0,0,0,14"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Glass background" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Frosted glass instead of solid black. No backdrop blur, just layered glass." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ChkBouncy"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Bouncy open/close" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Adds a spring overshoot when the panel opens or closes." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Lyrics -->
                        <ScrollViewer x:Name="LyricsPage"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="SOURCE" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkLyrics"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Fetch lyrics from LRCLIB" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Only title, artist, album, and duration are sent. The cache stays local." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="HIGHLIGHT COLOR" Style="{StaticResource SettingsCardTitle}" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Active lyric line" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Used for the highlighted line in the lyrics card." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="LyricsColorPreview"
                                                        Width="26"
                                                        Height="26"
                                                        CornerRadius="8"
                                                        Background="#7C9CFF"
                                                        BorderBrush="#33FFFFFF"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0" />
                                                <TextBox x:Name="TxtLyricsColor"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="90"
                                                         TextAlignment="Center"
                                                         MaxLength="7"
                                                         LostFocus="OnLyricsColorLostFocus"
                                                         KeyDown="OnLyricsColorKeyDown" />
                                            </StackPanel>
                                        </Grid>

                                        <Border x:Name="LyricsColorPreviewLine"
                                                CornerRadius="10"
                                                Padding="10,8"
                                                Margin="0,0,0,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#347C9CFF" Offset="0" />
                                                    <GradientStop Color="#187C9CFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="LyricsColorPreviewLineText"
                                                       Text="Active lyric line"
                                                       FontFamily="{StaticResource UiFont}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </Border>

                                        <WrapPanel x:Name="LyricsColorSwatches" Margin="0,0,0,2">
                                            <Button Style="{StaticResource ColorSwatch}" Background="#7C9CFF" Tag="#7C9CFF" ToolTip="Blue" Click="OnLyricsColorSwatchClick" />
                                            <Button Style="{StaticResource ColorSwatch}" Background="#32D74B" Tag="#32D74B" ToolTip="Green" Click="OnLyricsColorSwatchClick" />
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFB86B" Tag="#FFB86B" ToolTip="Amber" Click="OnLyricsColorSwatchClick" />
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FF6B9D" Tag="#FF6B9D" ToolTip="Pink" Click="OnLyricsColorSwatchClick" />
                                            <Button Style="{StaticResource ColorSwatch}" Background="#C08CFF" Tag="#C08CFF" ToolTip="Purple" Click="OnLyricsColorSwatchClick" />
                                            <Button Style="{StaticResource ColorSwatch}" Background="#F5F5F7" Tag="#F5F5F7" ToolTip="White" Click="OnLyricsColorSwatchClick" />
                                        </WrapPanel>

                                        <TextBlock Text="Hex #RRGGBB · default #7C9CFF"
                                                   Style="{StaticResource SettingsDescription}"
                                                   Margin="0,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Focus -->
                        <ScrollViewer x:Name="FocusPage"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="DURATIONS" Style="{StaticResource SettingsCardTitle}" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Focus" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Default deep work session." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtFocus"
                                                         Style="{StaticResource DarkTextBox}"
                                                         LostFocus="OnDurationLostFocus"
                                                         KeyDown="OnDurationKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="min" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Short break" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="A short reset between sessions." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtShort"
                                                         Style="{StaticResource DarkTextBox}"
                                                         LostFocus="OnDurationLostFocus"
                                                         KeyDown="OnDurationKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="min" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Long break" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="A longer reset every four sessions." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtLong"
                                                         Style="{StaticResource DarkTextBox}"
                                                         LostFocus="OnDurationLostFocus"
                                                         KeyDown="OnDurationKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="min" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="1–180 minutes. New durations apply after the timer is reset."
                                                   Style="{StaticResource SettingsDescription}"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="COMPLETION" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkChime"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Chime when a session ends" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Play a short system sound when focus or break finishes." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Water -->
                        <ScrollViewer x:Name="WaterPage"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="REMINDERS" Style="{StaticResource SettingsCardTitle}" />
                                        <CheckBox x:Name="ChkWater"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="OnToggleChanged"
                                                  Unchecked="OnToggleChanged">
                                            <StackPanel>
                                                <TextBlock Text="Water reminder" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="A gentle toast appears in the pill at the chosen interval." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="SCHEDULE" Style="{StaticResource SettingsCardTitle}" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Reminder interval" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="1–240 minutes." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtWaterInterval"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="56"
                                                         LostFocus="OnWaterLostFocus"
                                                         KeyDown="OnWaterKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="min" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Active hours" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Start equals end for 24 hours." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtWaterStart"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="52"
                                                         LostFocus="OnWaterLostFocus"
                                                         KeyDown="OnWaterKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="to" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="6,0" />
                                                <TextBox x:Name="TxtWaterEnd"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="52"
                                                         LostFocus="OnWaterLostFocus"
                                                         KeyDown="OnWaterKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="h" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="DAILY GOAL" Style="{StaticResource SettingsCardTitle}" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Glasses per day" Style="{StaticResource SettingsLabel}" />
                                                <TextBlock Text="Between 1 and 20 glasses." Style="{StaticResource SettingsDescription}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtWaterGoal"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="52"
                                                         LostFocus="OnWaterLostFocus"
                                                         KeyDown="OnWaterKeyDown"
                                                         PreviewTextInput="OnNumericPreview" />
                                                <TextBlock Text="glasses" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="WaterSettingsBars" Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border x:Name="WaterSettingsBar1" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar2" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar3" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar4" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar5" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar6" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar7" Width="24" Height="5" CornerRadius="2.5" Margin="0,0,4,0" Background="#2EFFFFFF" />
                                            <Border x:Name="WaterSettingsBar8" Width="24" Height="5" CornerRadius="2.5" Background="#2EFFFFFF" />
                                        </StackPanel>

                                        <TextBlock x:Name="WaterStatusText"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="WaterLogButton"
                                                    Style="{StaticResource SettingsPrimaryButton}"
                                                    Content="Log a glass"
                                                    Click="OnWaterLogClick" />
                                            <Button x:Name="WaterPreviewButton"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Content="Preview"
                                                    Margin="8,0,0,0"
                                                    Click="OnWaterPreviewClick" />
                                            <Button x:Name="WaterResetButton"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Content="Reset today"
                                                    Margin="8,0,0,0"
                                                    Click="OnWaterResetClick" />
                                        </StackPanel>

                                        <TextBlock Text="Reminders pause while the island is hidden. The daily counter follows your local date."
                                                   Style="{StaticResource SettingsDescription}"
                                                   Margin="0,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- About -->
                        <ScrollViewer x:Name="AboutPage"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,16">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE" Style="{StaticResource SettingsCardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="OpenDataButton"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Content="Open data folder"
                                                    Click="OnOpenDataFolderClick" />
                                            <Button x:Name="ClearLyricsButton"
                                                    Style="{StaticResource SettingsGhostButton}"
                                                    Content="Clear lyrics cache"
                                                    Margin="8,0,0,0"
                                                    Click="OnClearLyricsCacheClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="DataPathText"
                                                   Style="{StaticResource SettingsDescription}"
                                                   Margin="0,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="ABOUT" Style="{StaticResource SettingsCardTitle}" />
                                        <TextBlock Text="Dynamic Island for Windows"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="AboutText"
                                                   Style="{StaticResource SettingsDescription}"
                                                   FontSize="10.5"
                                                   LineHeight="17"
                                                   Margin="0,6,0,0"
                                                   Text="Notch, media, camera, file shelf, lyrics, focus timer, water reminder, battery, Wi-Fi, volume and brightness.&#10;&#10;Built with C# / WPF (.NET 8). Inspired by Nusa." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
