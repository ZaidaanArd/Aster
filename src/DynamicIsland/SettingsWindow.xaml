<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="520"
        Height="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#0B0B0C"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnWindowKeyDown">

    <Border Background="#0B0B0C"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#0B0B0C"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Settings"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Dynamic Island"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Style="{StaticResource GlyphButton}"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Click="OnCloseClick"
                        ToolTip="Close">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,18">

                    <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ChkStartup"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Start with Windows"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <CheckBox x:Name="ChkFullscreen"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Hide in fullscreen"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <TextBlock Text="Island otomatis sembunyi saat game atau video fullscreen."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap" />

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ChkMascot"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Show mascot when idle"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <CheckBox x:Name="ChkMinimal"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Minimal notch"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <CheckBox x:Name="ChkVolume"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Volume overlay"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <CheckBox x:Name="ChkBrightness"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Brightness overlay"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <CheckBox x:Name="ChkGlass"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Glass background"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <TextBlock Text="Panel transparan frosted. Matikan untuk hitam solid."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkBouncy"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Bouncy open/close"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <TextBlock Text="Spring sedikit overshoot saat panel membuka atau menutup."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap" />

                    <TextBlock Text="LYRICS" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ChkLyrics"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Fetch lyrics from LRCLIB"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <TextBlock Text="Hanya judul, artis, album, dan durasi yang dikirim. Cache lirik disimpan lokal."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Highlight color" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border x:Name="LyricsColorPreview"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="7"
                                    Background="#7C9CFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBox x:Name="TxtLyricsColor"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="90"
                                     TextAlignment="Center"
                                     MaxLength="7"
                                     LostFocus="OnLyricsColorLostFocus"
                                     KeyDown="OnLyricsColorKeyDown" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel x:Name="LyricsColorSwatches" Margin="0,0,0,4">
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#7C9CFF"
                                Tag="#7C9CFF"
                                ToolTip="Blue"
                                Click="OnLyricsColorSwatchClick" />
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#32D74B"
                                Tag="#32D74B"
                                ToolTip="Green"
                                Click="OnLyricsColorSwatchClick" />
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#FFB86B"
                                Tag="#FFB86B"
                                ToolTip="Amber"
                                Click="OnLyricsColorSwatchClick" />
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#FF6B9D"
                                Tag="#FF6B9D"
                                ToolTip="Pink"
                                Click="OnLyricsColorSwatchClick" />
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#C08CFF"
                                Tag="#C08CFF"
                                ToolTip="Purple"
                                Click="OnLyricsColorSwatchClick" />
                        <Button Style="{StaticResource ColorSwatch}"
                                Background="#F5F5F7"
                                Tag="#F5F5F7"
                                ToolTip="White"
                                Click="OnLyricsColorSwatchClick" />
                    </WrapPanel>
                    <TextBlock Text="Hex #RRGGBB · default #7C9CFF"
                               Style="{StaticResource SubtitleText}"
                               FontSize="9.5"
                               TextWrapping="Wrap" />

                    <TextBlock Text="FOCUS" Style="{StaticResource SectionHeader}" />

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Focus duration" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtFocus"
                                     Style="{StaticResource DarkTextBox}"
                                     LostFocus="OnDurationLostFocus"
                                     KeyDown="OnDurationKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="min"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Short break" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtShort"
                                     Style="{StaticResource DarkTextBox}"
                                     LostFocus="OnDurationLostFocus"
                                     KeyDown="OnDurationKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="min"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Long break" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtLong"
                                     Style="{StaticResource DarkTextBox}"
                                     LostFocus="OnDurationLostFocus"
                                     KeyDown="OnDurationKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="min"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkChime"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Chime when a session ends"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />
                    <TextBlock Text="Durasi 1–180 menit. Timer akan reset ke durasi baru setelah sesi direset."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap" />

                    <TextBlock Text="WATER" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="ChkWater"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Water reminder"
                              Margin="0,0,0,10"
                              Checked="OnToggleChanged"
                              Unchecked="OnToggleChanged" />

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Reminder interval" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtWaterInterval"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="56"
                                     LostFocus="OnWaterLostFocus"
                                     KeyDown="OnWaterKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="min"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Active hours" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtWaterStart"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52"
                                     LostFocus="OnWaterLostFocus"
                                     KeyDown="OnWaterKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="to"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="6,0" />
                            <TextBox x:Name="TxtWaterEnd"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52"
                                     LostFocus="OnWaterLostFocus"
                                     KeyDown="OnWaterKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="h"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Daily goal" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtWaterGoal"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="52"
                                     LostFocus="OnWaterLostFocus"
                                     KeyDown="OnWaterKeyDown"
                                     PreviewTextInput="OnNumericPreview" />
                            <TextBlock Text="glasses"
                                       Style="{StaticResource SettingsLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="WaterStatusText"
                               Style="{StaticResource SubtitleText}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="WaterLogButton"
                                Style="{StaticResource DarkButton}"
                                Content="Log a glass"
                                Click="OnWaterLogClick" />
                        <Button x:Name="WaterPreviewButton"
                                Style="{StaticResource DarkButton}"
                                Content="Preview"
                                Margin="8,0,0,0"
                                Click="OnWaterPreviewClick" />
                        <Button x:Name="WaterResetButton"
                                Style="{StaticResource DarkButton}"
                                Content="Reset today"
                                Margin="8,0,0,0"
                                Click="OnWaterResetClick" />
                    </StackPanel>
                    <TextBlock Text="Reminder muncul di pill walau panel tertutup, dan ditahan saat island disembunyikan. Interval 1–240 menit, jam 0–23 (start = end berarti 24 jam), goal 1–20 gelas."
                               Style="{StaticResource SubtitleText}"
                               FontSize="10"
                               TextWrapping="Wrap" />

                    <TextBlock Text="DATA" Style="{StaticResource SectionHeader}" />
                    <Button x:Name="OpenDataButton"
                            Style="{StaticResource DarkButton}"
                            Content="Open data folder"
                            HorizontalAlignment="Left"
                            Click="OnOpenDataFolderClick" />
                    <Button x:Name="ClearLyricsButton"
                            Style="{StaticResource DarkButton}"
                            Content="Clear lyrics cache"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="OnClearLyricsCacheClick" />
                    <TextBlock x:Name="DataPathText"
                               Style="{StaticResource SubtitleText}"
                               FontSize="9.5"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="AboutText"
                               Style="{StaticResource SubtitleText}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               LineHeight="17"
                               Text="Dynamic Island for Windows — notch, media, camera, file shelf, lyrics, focus timer, water reminder, battery, Wi-Fi, volume and brightness.&#10;Built with C# / WPF (.NET 8). Inspired by Nusa." />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <TextBlock x:Name="VersionText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="10"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource DarkButton}"
                        Content="Close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
