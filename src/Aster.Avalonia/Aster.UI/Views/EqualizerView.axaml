<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aster.UI.Views.EqualizerView">
  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Border x:Name="Bar1" Width="2" Height="6" Background="#F5F4F0" CornerRadius="1" />
    <Border x:Name="Bar2" Width="2" Height="10" Background="#F5F4F0" CornerRadius="1" />
    <Border x:Name="Bar3" Width="2" Height="4" Background="#F5F4F0" CornerRadius="1" />
  </StackPanel>
</UserControl>
