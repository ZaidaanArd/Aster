<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.Avalonia.ViewModels"
             x:Class="Aster.Avalonia.Views.ExpandedMediaView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18,18,18,14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding DateText}" Foreground="#A0A0A8" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ClockText}" Foreground="#F5F4F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding BatteryText}" Foreground="#B8B8C0" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Text="{Binding WifiText}" Foreground="#B8B8C0" FontSize="11" Opacity="{Binding WifiOpacity}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="96,14,*" IsVisible="{Binding HasMedia}" Margin="0,12,0,0">
      <Border Width="96" Height="96" CornerRadius="12" ClipToBounds="True">
        <Image Source="{Binding Media.ArtworkImage}" Stretch="UniformToFill" />
      </Border>
      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{Binding Media.Title}" Foreground="#F5F4F0" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Media.Artist}" Foreground="#B8B8C0" FontSize="13" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Media.SourceApp}" Foreground="#7A7A84" FontSize="11" />
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <Button Content="Prev" Command="{Binding Media.PreviousCommand}" />
          <Button Content="Play/Pause" Command="{Binding Media.PlayPauseCommand}" />
          <Button Content="Next" Command="{Binding Media.NextCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1"
               Text="Nothing playing"
               IsVisible="{Binding HasNoMedia}"
               Foreground="#B8B8C0"
               FontSize="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <StackPanel>
        <Slider x:Name="SeekSlider"
                Minimum="0"
                Maximum="{Binding Media.DurationSeconds}"
                Value="{Binding Media.PositionSeconds, Mode=TwoWay}"
                PointerReleased="OnSeekReleased" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Media.PositionText}" Foreground="#7A7A84" FontSize="10" />
          <TextBlock Grid.Column="1" Text="{Binding Media.DurationText}" Foreground="#7A7A84" FontSize="10" />
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
        <TextBlock Text="Music" Foreground="#F5F4F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="Settings" Click="OnSettingsClick" />
        <Button Content="Close" Click="OnCloseClick" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
